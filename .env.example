# Copiar a .env y completar. .env está en .gitignore: nunca commitear secretos reales.

# --- Motor de IA (obligatorio) ---
# Proveedor real: DeepInfra (https://deepinfra.com), servido vía su
# endpoint compatible con la API de OpenAI. No confundir con una key de
# OpenAI: se genera en el dashboard de DeepInfra.
DEEPINFRA_API_KEY=di-...
# Rara vez hace falta cambiar esto (otra región/proxy compatible).
SANTISIMA_DEEPINFRA_API_BASE=https://api.deepinfra.com/v1/openai

# --- Seguridad HTTP (SESSION_SECRET obligatorio fuera de SANTISIMA_DEBUG=true) ---
# Secreto HMAC para firmar session_id y device_token. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SANTISIMA_SESSION_SECRET=cambia-este-secreto
# API keys de ADMINISTRACIÓN (revocar un dispositivo abusivo, etc.) — NUNCA
# se distribuyen dentro de la app; la app usa device_token, que obtiene
# sola vía POST /api/v1/dispositivos sin necesitar ninguna key aquí.
# Puede quedar vacío: solo deja inalcanzables los endpoints /admin/*.
SANTISIMA_API_KEYS=cambia-esta-key-por-una-generada-con-secrets.token_urlsafe

# --- Identidad de dispositivo (usuarios finales de la app) ---
SANTISIMA_DISPOSITIVOS_DB_PATH=dispositivos.db

# --- Persistencia ---
SANTISIMA_USAR_SQLITE=true
SANTISIMA_SQLITE_DB_PATH=conversations.db
# Clave Fernet para cifrar el contenido en reposo. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SANTISIMA_CLAVE_CIFRADO=
SANTISIMA_RETENCION_DIAS=90
# Archivo donde scripts/purgar_retencion.py registra su última ejecución
# (leído por GET /metrics/health). Ver monitoring/README.md.
SANTISIMA_PURGA_ESTADO_PATH=purga_estado.json

# --- Consentimiento (ver docs/compliance/DPIA.md §4) ---
# Subir este valor cuando cambie el contenido de docs/privacidad.md:
# fuerza a todos los dispositivos a re-aceptar el aviso nuevo antes de
# poder volver a enviar mensajes.
SANTISIMA_AVISO_PRIVACIDAD_VERSION=v1

# --- Escalar a múltiples instancias (apagado por defecto, ver README) ---
# Activar solo cuando vayas a correr más de una instancia del backend a la
# vez. Requieren los extras: pip install -e ".[postgres,redis]"
SANTISIMA_USAR_POSTGRES=false
SANTISIMA_POSTGRES_DSN=postgresql://usuario:password@host:5432/la_santisima
SANTISIMA_USAR_REDIS_RATE_LIMIT=false
SANTISIMA_REDIS_URL=redis://host:6379/0

# --- Límites ---
SANTISIMA_RATE_LIMIT_POR_MINUTO=20
# Registros de dispositivo (POST /api/v1/dispositivos) permitidos por IP
# por minuto. Holgado a propósito (un usuario real solo registra una vez):
# protege el cupo del LLM contra un bucle automatizado, sin interrumpir el
# uso normal.
SANTISIMA_RATE_LIMIT_REGISTRO_POR_MINUTO=10
SANTISIMA_MAX_LONGITUD_MENSAJE=4000

# --- Desarrollo local únicamente ---
# true permite arrancar sin session secret (NUNCA en producción).
SANTISIMA_DEBUG=false
SANTISIMA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
