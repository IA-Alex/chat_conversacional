.env
.venv/
venv/
__pycache__/
.crewai/
output/

# Bases de datos locales: contienen device_id, consentimiento y (si no hay
# SANTISIMA_CLAVE_CIFRADO configurada) contenido conversacional en texto
# plano. Nunca deben versionarse (ver docs/despliegue.md §7).
*.db
*.db-wal
*.db-shm

# Artefactos de test/lint/build que no deben versionarse.
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Assets de frontend/referencia visual (imágenes, video de referencia de
# la deidad, etc.): no pertenecen al repositorio del backend.
deidad_1.jpeg
dea.mp4
propuesta_index/
propuesta_index.tar.gz

# Resultados de las pruebas de carga (tests/load/). Los CSV/HTML de Locust
# son artefactos de una corrida concreta (máquina, fecha, red), no fuente:
# versionarlos llenaría el repo de números que no se pueden reproducir ni
# comparar entre sí. El directorio SÍ se versiona (tiene un .gitkeep) porque
# el comando documentado en tests/load/README.md escribe ahí con --csv y
# Locust no crea el directorio solo.
tests/load/resultados/*
!tests/load/resultados/.gitkeep
